{
  "buildCommand": "npm run build:ssg",
  "outputDirectory": "dist-ssg",
  "installCommand": "npm install",
  "framework": null,

  "redirects": [
    {
      "source": "/reservation-taxi-vsl/",
      "destination": "/reservation-taxi-vsl",
      "permanent": true
    },
    {
      "source": "/taxi-conventionne-hauts-de-seine-92/",
      "destination": "/taxi-conventionne-hauts-de-seine-92",
      "permanent": true
    },
    {
      "source": "/taxi-conventionne-hauts-de-seine-92/levallois-perret/",
      "destination": "/taxi-conventionne-hauts-de-seine-92/levallois-perret",
      "permanent": true
    },
    {
      "source": "/:path((?!.*\\..*).+)/",
      "destination": "/:path*",
      "permanent": true
    }
  ],

  "rewrites": [],

  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
